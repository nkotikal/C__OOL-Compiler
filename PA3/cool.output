Terminals unused in grammar

    ERROR


Grammar

    0 $accept: program $end

    1 program: class_list

    2 class_list: class
    3           | class_list class
    4           | error ';'
    5           | class_list error ';'

    6 class: CLASS TYPEID '{' dummy_feature_list '}' ';'
    7      | CLASS TYPEID INHERITS TYPEID '{' dummy_feature_list '}' ';'

    8 dummy_feature_list: ε
    9                   | feature_list

   10 feature_list: feature ';'
   11             | feature_list feature ';'
   12             | error ';'
   13             | feature_list error ';'

   14 feature: OBJECTID '(' dummy_formal_list ')' ':' TYPEID '{' expr '}'
   15        | OBJECTID ':' TYPEID
   16        | OBJECTID ':' TYPEID ASSIGN expr

   17 dummy_formal_list: ε
   18                  | formal_list

   19 formal_list: formal
   20            | formal_list ',' formal

   21 formal: OBJECTID ':' TYPEID

   22 dummy_actuals: ε
   23              | actuals_list

   24 actuals_list: expr
   25             | actuals_list ',' expr

   26 expr_list: expr ';'
   27          | expr_list expr ';'
   28          | error ';'
   29          | expr_list error ';'

   30 case_list: case
   31          | case_list case

   32 case: OBJECTID ':' TYPEID DARROW expr ';'

   33 let_expr: OBJECTID ':' TYPEID IN expr
   34         | OBJECTID ':' TYPEID ASSIGN expr IN expr
   35         | OBJECTID ':' TYPEID ',' let_expr
   36         | OBJECTID ':' TYPEID ASSIGN expr ',' let_expr
   37         | error IN expr
   38         | error ',' let_expr

   39 expr: OBJECTID ASSIGN expr
   40     | expr '.' OBJECTID '(' dummy_actuals ')'
   41     | expr '@' TYPEID '.' OBJECTID '(' dummy_actuals ')'
   42     | OBJECTID '(' dummy_actuals ')'
   43     | IF expr THEN expr ELSE expr FI
   44     | WHILE expr LOOP expr POOL
   45     | '{' expr_list '}'
   46     | LET let_expr
   47     | CASE expr OF case_list ESAC
   48     | NEW TYPEID
   49     | ISVOID expr
   50     | expr '+' expr
   51     | expr '-' expr
   52     | expr '*' expr
   53     | expr '/' expr
   54     | '~' expr
   55     | expr '<' expr
   56     | expr LE expr
   57     | expr '=' expr
   58     | NOT expr
   59     | '(' expr ')'
   60     | OBJECTID
   61     | INT_CONST
   62     | STR_CONST
   63     | BOOL_CONST


